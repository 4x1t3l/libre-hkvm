        <!-- Discord OAuth Credentials -->
        <div class="settings-section" id="discordCredsSection" style="display: none;">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/></svg></span>
