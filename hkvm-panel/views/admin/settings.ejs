            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Guild ID (Server ID)</div>
                <div class="settings-row-desc">Discord server where users will be added</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="discord_guild_id" data-key="discord_guild_id" placeholder="Your Discord Server ID (optional)">
