              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="discord_auto_role_id" data-key="discord_auto_role_id" placeholder="Discord Role ID for auto-assignment (optional)">
              </div>
            </div>
          </div>
        </div>

        <!-- Discord Setup Guide -->
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Discord Setup Guide</div>
