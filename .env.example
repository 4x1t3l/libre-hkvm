# Copy to .env and adjust.  Everything here is optional, but the two
# secrets below are the ones that matter.

# ---------------------------------------------------------------------------
# Session signing key.  Minimum 32 characters.
# If this is not set, a random key is generated on first boot and stored in
# the data directory (mode 0600).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Password for the "admin" account on first boot.
# If this is not set, a random password is generated and printed once.
HKVM_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# HTTP port
PORT=8080

# Where the SQLite database and the generated session secret are stored
HKVM_DATA_DIR=

# Set to 1 when the panel sits behind a TLS-terminating reverse proxy, so
# that the Secure cookie flag is set correctly.
HKVM_TRUST_PROXY=

# Set to 1 to force the Secure cookie flag outside production.
HKVM_SECURE_COOKIES=

# Login rate limits (per 15 minutes)
HKVM_LOGIN_LIMIT_PER_IP=30
HKVM_LOGIN_LIMIT_PER_ACCOUNT=5

# Set to 1 to allow template downloads from private addresses.
HKVM_ALLOW_PRIVATE_DOWNLOADS=

# Branding
PANEL_NAME=Librefied by 4x1t3l
PANEL_VERSION=V3.0
DEFAULT_LOGO_URL=
